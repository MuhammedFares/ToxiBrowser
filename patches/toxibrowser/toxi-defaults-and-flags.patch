 ChromeFeatureListCreator::~ChromeFeatureListCreator() = default;
 
+namespace {
+
+void ApplyToxiDefaultSwitches(base::CommandLine* command_line) {
+  if (!command_line->HasSwitch(switches::kEnableSmoothScrolling) &&
+      !command_line->HasSwitch(switches::kDisableSmoothScrolling)) {
+    command_line->AppendSwitch(switches::kDisableSmoothScrolling);
+  }
+  if (!command_line->HasSwitch(gfx::switches::kForcePrefersReducedMotion) &&
+      !command_line->HasSwitch(gfx::switches::kForcePrefersNoReducedMotion)) {
+    command_line->AppendSwitch(gfx::switches::kForcePrefersReducedMotion);
+  }
+}
+
+}  // namespace
+
 void ChromeFeatureListCreator::CreateFeatureList() {
   CreatePrefService();
   ConvertFlagsToSwitches();
+  ApplyToxiDefaultSwitches(base::CommandLine::ForCurrentProcess());
   CreateMetricsServices();
   SetupInitialPrefs();
   SetUpFieldTrials();
